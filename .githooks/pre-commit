#!/usr/bin/env bash
# .githooks/pre-commit
#
# Fast pre-commit gate: format-check, lint, typecheck, security, compile,
# unit tests (no model load). Runs only on staged .py files' scope but
# exercises the full toolchain so CI surprises are caught locally.
#
# Install:
#   git config core.hooksPath .githooks
# or:
#   make setup-hooks
#
# Bypass (use sparingly):
#   git commit --no-verify
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Require the venv to exist; run `make sync` first if it doesn't.
if [[ ! -x ".venv/bin/ember" ]]; then
    echo "pre-commit: .venv/bin/ember not found — run 'make sync' first" >&2
    exit 1
fi

echo "pre-commit: running pr-ready gate (no model load)..."
make pr-ready
