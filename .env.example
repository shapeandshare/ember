# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then load it before running any aws-* targets:
#   source .env && make aws-preflight
#
# .env is gitignored — never commit credentials.

# Tailscale OAuth client credentials for ember AWS deployment.
# Create an OAuth client at https://login.tailscale.com/admin/settings/oauth
# Required scopes: Auth Keys (write), Devices > Core (write), DNS (read)
# Tags field: tag:ember  (create the tag first at Admin console -> Access Controls -> Tags)
TS_OAUTH_CLIENT_ID=
TS_OAUTH_CLIENT_SECRET=
